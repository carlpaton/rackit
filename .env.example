# MongoDB Atlas — connection string for your cluster.
# Get from: MongoDB Atlas → Database → Connect → Drivers → Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rackit?retryWrites=true&w=majority

# NextAuth.js — random secret used to sign cookies and JWTs.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here

# NextAuth.js — canonical URL of the app.
# Use http://localhost:3000 for local dev; use the Vercel deployment URL in production.
NEXTAUTH_URL=http://localhost:3000
